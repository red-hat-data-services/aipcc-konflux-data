{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "regexManagers": [
    {
      "fileMatch": [
        "pipelines/full-container.yaml"
      ],
      "matchStrings": [
        "quay.io/konflux-ci/tekton-catalog/(?<depName>[a-zA-Z0-9._-]+):(?<version>[^@]+)@sha256:(?<currentValue>[a-fA-F0-9]{64})"
      ],
      "depNameTemplate": "quay.io/konflux-ci/tekton-catalog/{{depName}}",
      "datasourceTemplate": "docker",
      "versioningTemplate": "digest"
    }
  ]
}
