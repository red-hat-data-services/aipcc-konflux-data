{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>redhat/rhel-ai/renovate-config"
  ],
  "ignoreTests": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update cloud-importer container images in task scripts",
      "fileMatch": [
        "tasks/extract-and-upload-cloud-image\\.yaml$"
      ],
      "matchStrings": [
        "(?<depName>quay\\.io/aipcc-cicd/cloud-importer):(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update Tekton git resolver references for GitHub repos (mapt, cloud-importer)",
      "fileMatch": [
        "pipelines/.*\\.yaml$"
      ],
      "matchStrings": [
        "- name: url\\s+value:\\s*\"https://github\\.com/(?<depName>[^\"]+)\"\\s+- name: revision\\s+value:\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ],
  "tekton": {
    "enabled": true,
    "includePaths": [
      "pipelines/**",
      "tasks/**"
    ],
    "packageRules": [
      {
        "matchUpdateTypes": [
          "digest"
        ],
        "matchBaseBranches": [],
        "platformAutomerge": true,
        "automerge": true
      },
      {
        "description": "Pin apply-tags in modelcar.yaml (block Renovate from updating)",
        "matchFileNames": [
          "pipelines/modelcar.yaml",
          "pipelines/models-oci-copy.yaml"
        ],
        "matchPackageNames": [
          "quay.io/konflux-ci/tekton-catalog/task-apply-tags"
        ],
        "enabled": false
      }
    ]
  }
}
