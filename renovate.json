{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>redhat/rhel-ai/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
	"pipelines/.*\\.yaml$"
      ],
      "matchStrings": [
        "value: (?<depName>quay.io\/konflux-ci\/tekton-catalog\/[^:]+):(?<currentValue>[^@]+)(@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"      
    }
  ]
}
