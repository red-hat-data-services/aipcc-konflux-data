{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>redhat/rhel-ai/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
	"pipelines/full-container.yaml"
      ],
      "matchStrings": [
        "value: (?<depName>[^:]+):(?<currentValue>[^@]+)(@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "autoReplaceStringTemplate": "value: {{{depName}}}:{{{currentValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}",
      "datasourceTemplate": "docker"      
    }
  ]
}
