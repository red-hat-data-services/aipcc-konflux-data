{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
	"pipelines/full-container.yaml"
      ],
      "matchStrings": [
	"value: quay.io\/konflux-ci\/tekton-catalog\/(?<depName>(.*)):(?<version>(.*))@sha256:(?<currentValue>(.*))"
      ],
      "depNameTemplate": "quay.io/konflux-ci/tekton-catalog/{{depName}}",
      "datasourceTemplate": "docker",
      "versioningTemplate": "digest"
    }
  ]
}
