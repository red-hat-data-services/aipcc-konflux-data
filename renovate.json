{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>redhat/rhel-ai/renovate-config"
  ],
  "ignoreTests": true,
  "tekton": {
    "enabled": true,
    "includePaths": [
      "pipelines/**"
    ],
    "packageRules": [
      {
        "matchUpdateTypes": [
          "digest"
        ],
        "matchBaseBranches": [],
        "platformAutomerge": true,
        "automerge": true
      },
      {
        "description": "Pin apply-tags in modelcar.yaml (block Renovate from updating)",
        "matchPaths": ["pipelines/modelcar.yaml", "pipelines/models-oci-copy.yaml"],
        "matchPackageNames": ["quay.io/konflux-ci/tekton-catalog/task-apply-tags"],
        "enabled": false
      }
    ]
  }
}
