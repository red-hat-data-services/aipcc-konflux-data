{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>redhat/rhel-ai/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
	"pipelines/full-container.yaml"
      ],
      "matchStrings": [
        "value: (?<depName>quay.io\/konflux-ci\/tekton-catalog\/[^:]+):(?<currentValue>[-a-zA-Z0-9.]+)(?:@(?<currentDigest>sha256:[a-zA-Z0-9]+))?"
      ],
      "autoReplaceStringTemplate": "value:= {{{depName}}}:{{{newValue}}}@{{{newDigest}}}",
      "datasourceTemplate": "docker"      
    }
  ]
}
